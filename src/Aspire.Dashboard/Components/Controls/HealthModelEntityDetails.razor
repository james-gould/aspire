@using Aspire.Dashboard.Components.Controls.Grid
@using Aspire.Dashboard.Model.HealthModel
@using Aspire.Dashboard.Resources
@using Aspire.Dashboard.Utils

@inject IStringLocalizer<Dashboard.Resources.HealthModel> Loc

<div class="health-model-details-layout">
    <FluentAccordion>
        <FluentAccordionItem Heading="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelEntityColumnHeader)]" Expanded="true">
            <div class="health-model-property-list">
                <div class="health-model-property">
                    <span class="health-model-property-name">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelTypeColumnHeader)]</span>
                    <span class="health-model-property-value">@Node.Entity.Category</span>
                </div>
                <div class="health-model-property">
                    <span class="health-model-property-name">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelHealthColumnHeader)]</span>
                    <span class="health-model-property-value">
                        @{
                            var (icon, color) = HealthModelIconHelpers.GetHealthStateIcon(Node.State);
                        }
                        <FluentIcon Value="@icon" Color="@color" />
                        @Node.State.ToString()
                    </span>
                </div>
                <div class="health-model-property">
                    <span class="health-model-property-name">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelPropertySignalsState)]</span>
                    <span class="health-model-property-value">@Node.SignalsState.ToString()</span>
                </div>
                <div class="health-model-property">
                    <span class="health-model-property-name">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelPropertyDependenciesState)]</span>
                    <span class="health-model-property-value">
                        @if (Node.DependenciesState is { } dependenciesState)
                        {
                            @dependenciesState.ToString()
                        }
                        else
                        {
                            <span class="empty-data"></span>
                        }
                    </span>
                </div>
                <div class="health-model-property">
                    <span class="health-model-property-name">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelPropertyImpact)]</span>
                    <span class="health-model-property-value">@Node.Entity.Impact.ToString()</span>
                </div>
                <div class="health-model-property">
                    <span class="health-model-property-name">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelPropertyRollup)]</span>
                    <span class="health-model-property-value">@RollupDescription</span>
                </div>
                @if (Node.Entity.ResourceName is { } resourceName)
                {
                    <div class="health-model-property">
                        <span class="health-model-property-name">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelPropertyResource)]</span>
                        <span class="health-model-property-value">
                            <a href="@DashboardUrls.ResourcesUrl(resource: resourceName)">@resourceName</a>
                        </span>
                    </div>
                }
            </div>
        </FluentAccordionItem>

        <FluentAccordionItem Heading="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelSignalsHeader)]" Expanded="true">
            <div slot="end">
                <FluentBadge Appearance="Appearance.Neutral" Circular="true">@Node.Entity.Signals.Length</FluentBadge>
            </div>
            @if (Node.Entity.Signals.Length == 0)
            {
                <div class="health-model-empty">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelNoSignals)]</div>
            }
            else
            {
                <FluentDataGrid TGridItem="HealthModelSignal"
                                Items="@Node.Entity.Signals.AsQueryable()"
                                ItemKey="@(s => s.Name)"
                                GenerateHeader="GenerateHeaderOption.Sticky"
                                RowSize="DataGridRowSize.Medium"
                                GridTemplateColumns="1.5fr 1fr 2fr"
                                Style="width:100%">
                    <AspireTemplateColumn Title="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelSignalColumnHeader)]"
                                          Tooltip="true"
                                          TooltipText="@(s => s.DisplayName ?? s.Name)">
                        @(context.DisplayName ?? context.Name)
                    </AspireTemplateColumn>
                    <AspireTemplateColumn Title="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelStateColumnHeader)]">
                        @{
                            var (signalIcon, signalColor) = HealthModelIconHelpers.GetHealthStateIcon(context.State);
                        }
                        <FluentIcon Value="@signalIcon" Color="@signalColor" />
                        @context.State.ToString()
                    </AspireTemplateColumn>
                    <AspireTemplateColumn Title="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelDetailsColumnHeader)]"
                                          Tooltip="true"
                                          TooltipText="@(s => s.Description)">
                        @context.Description
                    </AspireTemplateColumn>
                </FluentDataGrid>
            }
        </FluentAccordionItem>

        <FluentAccordionItem Heading="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelDependenciesHeader)]" Expanded="@(Node.Children.Length > 0)">
            <div slot="end">
                <FluentBadge Appearance="Appearance.Neutral" Circular="true">@Node.Children.Length</FluentBadge>
            </div>
            @if (Node.Children.Length == 0)
            {
                <div class="health-model-empty">@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelNoDependencies)]</div>
            }
            else
            {
                <FluentDataGrid TGridItem="HealthModelNode"
                                Items="@Node.Children.AsQueryable()"
                                ItemKey="@(n => n.Name)"
                                GenerateHeader="GenerateHeaderOption.Sticky"
                                RowSize="DataGridRowSize.Medium"
                                GridTemplateColumns="1.5fr 1fr 1fr"
                                Style="width:100%">
                    <AspireTemplateColumn Title="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelEntityColumnHeader)]"
                                          Tooltip="true"
                                          TooltipText="@(n => n.DisplayName)">
                        @context.DisplayName
                    </AspireTemplateColumn>
                    <AspireTemplateColumn Title="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelHealthColumnHeader)]">
                        @{
                            var (childIcon, childColor) = HealthModelIconHelpers.GetHealthStateIcon(context.State);
                        }
                        <FluentIcon Value="@childIcon" Color="@childColor" />
                        @context.State.ToString()
                    </AspireTemplateColumn>
                    <AspireTemplateColumn Title="@Loc[nameof(Dashboard.Resources.HealthModel.HealthModelPropertyImpact)]">
                        @context.Entity.Impact.ToString()
                    </AspireTemplateColumn>
                </FluentDataGrid>
            }
        </FluentAccordionItem>
    </FluentAccordion>
</div>

@code {
    [Parameter, EditorRequired]
    public required HealthModelNode Node { get; set; }

    private string RollupDescription => Pages.HealthModel.GetRollupDescription(Node.Entity.Dependencies, Loc);
}
